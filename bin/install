#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PLUGIN_ID=$(jq -r '.id' "$ROOT_DIR/manifest.json")
TARGET_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"

omarchy plugin validate "$ROOT_DIR"

mkdir -p "$HOME/.config/omarchy/plugins"
STAGE_DIR="$HOME/.config/omarchy/plugins/.stage.$PLUGIN_ID.$$"
rm -rf "$STAGE_DIR"
mkdir -p "$STAGE_DIR"

cp "$ROOT_DIR/manifest.json" "$STAGE_DIR/"
cp "$ROOT_DIR/LICENSE" "$STAGE_DIR/"
cp "$ROOT_DIR/setup.sh" "$STAGE_DIR/"
cp "$ROOT_DIR/ScreenLens.qml" "$STAGE_DIR/"
cp "$ROOT_DIR/SettingsPanel.qml" "$STAGE_DIR/"
cp "$ROOT_DIR/PlainText.qml" "$STAGE_DIR/"
cp "$ROOT_DIR/ScreenLensLogic.js" "$STAGE_DIR/"
cp -R "$ROOT_DIR/scripts" "$STAGE_DIR/"
cp -R "$ROOT_DIR/i18n" "$STAGE_DIR/"
chmod +x "$STAGE_DIR"/setup.sh "$STAGE_DIR"/scripts/*.py

omarchy plugin validate "$STAGE_DIR"
rm -rf "$TARGET_DIR"
mv "$STAGE_DIR" "$TARGET_DIR"

# Qt6 caches compiled QML by file:// URL across in-process plugin rescans, so
# restart omarchy-shell to ensure updated QML is compiled fresh from disk.
omarchy restart shell >/dev/null 2>&1 || true

for _ in $(seq 1 40); do
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

if [[ -f "$HOME/.config/omarchy/shell.json" ]] && \
  jq -e --arg id "$PLUGIN_ID" '(.bar.layout // {} | to_entries | map(.value[]) | any(.[]; (.id // .) == $id))' "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1; then
  omarchy plugin enable "$PLUGIN_ID"
else
  omarchy plugin enable "$PLUGIN_ID" --section right
fi
echo "Installed and enabled $PLUGIN_ID at $TARGET_DIR"
